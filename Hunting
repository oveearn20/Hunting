local function Dropdown(page, title, options, defaultId, cb)
    local ROW, ITEM, GAP, PAD, MAXLIST = 46, 34, 4, 6, 176
    local cur = options[1]
    for _, o in ipairs(options) do if o.id == defaultId then cur = o end end
    local opened = false
    local listH, openH = 0, 0

    local holder = new("Frame", {Size = UDim2.new(1, 0, 0, ROW), BackgroundTransparency = 1,
        ClipsDescendants = true}, page)

    local row = new("TextButton", {Text = "", AutoButtonColor = false, BackgroundColor3 = C.white,
        Size = UDim2.new(1, 0, 0, ROW)}, holder)
    round(row, 14)
    grad(row, Color3.fromRGB(16, 32, 78), Color3.fromRGB(8, 16, 40), 90)
    local rs = stroke(row, C.bright, 1.2, 0.6)

    text(row, title, 10, Enum.Font.GothamMedium, {Position = UDim2.fromOffset(15, 7),
        Size = UDim2.new(1, -60, 0, 12), TextXAlignment = Enum.TextXAlignment.Left, TextTransparency = 0.45})
    local val = text(row, cur.label, 13, Enum.Font.GothamBold, {Position = UDim2.fromOffset(15, 21),
        Size = UDim2.new(1, -60, 0, 18), TextXAlignment = Enum.TextXAlignment.Left,
        TextTruncate = Enum.TextTruncate.AtEnd})

    local chip = new("Frame", {AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -10, 0.5, 0),
        Size = UDim2.fromOffset(28, 28), BackgroundColor3 = C.blue, BackgroundTransparency = 0.55}, row)
    round(chip, 14)
    local arrow = text(chip, ">", 14, Enum.Font.GothamBold, {Size = UDim2.fromScale(1, 1), Rotation = 90})

    local list = new("ScrollingFrame", {Position = UDim2.fromOffset(0, ROW + 6), Size = UDim2.new(1, 0, 0, 10),
        BackgroundColor3 = C.white, BorderSizePixel = 0, ScrollBarThickness = 2, ScrollBarImageColor3 = C.bright,
        AutomaticCanvasSize = Enum.AutomaticSize.Y, CanvasSize = UDim2.new(), ClipsDescendants = true}, holder)
    round(list, 14)
    grad(list, Color3.fromRGB(14, 28, 68), Color3.fromRGB(7, 14, 36), 90)
    stroke(list, C.bright, 1.1, 0.65)
    new("UIListLayout", {Padding = UDim.new(0, GAP)}, list)
    new("UIPadding", {PaddingTop = UDim.new(0, PAD), PaddingBottom = UDim.new(0, PAD),
        PaddingLeft = UDim.new(0, PAD), PaddingRight = UDim.new(0, PAD)}, list)

    local items = {}
    local function paint(anim)
        local d = anim and 0.18 or 0
        for id, it in pairs(items) do
            local on = (id == cur.id)
            tw(it.btn, d, {BackgroundTransparency = on and 0.45 or 1})
            tw(it.dot, d, {BackgroundTransparency = on and 0 or 1})
            tw(it.lbl, d, {TextTransparency = on and 0 or 0.25})
        end
    end
    local function close()
        opened = false
        tw(holder, 0.28, {Size = UDim2.new(1, 0, 0, ROW)}, Enum.EasingStyle.Quint)
        tw(arrow, 0.28, {Rotation = 90}, Enum.EasingStyle.Quint)
        tw(rs, 0.2, {Transparency = 0.6})
    end
    local function sizes()
        local n = #options
        listH = math.min(n * ITEM + math.max(n - 1, 0) * GAP + PAD * 2, MAXLIST)
        openH = ROW + 6 + listH
        list.Size = UDim2.new(1, 0, 0, listH)
        if opened then holder.Size = UDim2.new(1, 0, 0, openH) end
    end
    local function build()
        for _, it in pairs(items) do it.btn:Destroy() end
        items = {}
        for i, o in ipairs(options) do
            local b = new("TextButton", {Text = "", AutoButtonColor = false, BackgroundColor3 = C.blue,
                BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, ITEM), LayoutOrder = i}, list)
            round(b, 10)
            local lbl = text(b, o.label, 12, Enum.Font.GothamMedium, {Position = UDim2.fromOffset(14, 0),
                Size = UDim2.new(1, -44, 1, 0), TextXAlignment = Enum.TextXAlignment.Left,
                TextTruncate = Enum.TextTruncate.AtEnd, TextTransparency = 0.25})
            local dot = new("Frame", {AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -14, 0.5, 0),
                Size = UDim2.fromOffset(8, 8), BackgroundColor3 = C.glow, BackgroundTransparency = 1}, b)
            round(dot, 4)
            items[o.id] = {btn = b, dot = dot, lbl = lbl}
            b.MouseEnter:Connect(function()
                if o.id ~= cur.id then tw(b, 0.15, {BackgroundTransparency = 0.82}) end
            end)
            b.MouseLeave:Connect(function()
                if o.id ~= cur.id then tw(b, 0.15, {BackgroundTransparency = 1}) end
            end)
            b.MouseButton1Click:Connect(function()
                local changed = (cur.id ~= o.id)
                cur = o
                val.Text = o.label
                paint(true)
                close()
