local function groundY(x, z, fromY)
    local r = cast(Vector3.new(x, fromY + 4, z), Vector3.new(0, -40, 0))
    return r and r.Position.Y or nil
end

-- จำกัดจุดหลบ/แดช: 1) ห้ามออกนอกโซน/ห้องที่ยืนอยู่ตอนนี้  2) ยิงเรย์เช็คกำแพง ถ้าชนให้หยุดก่อนกำแพง
clampDodge = function(root, pt)
    if not root or typeof(pt) ~= "Vector3" then return pt end
    local pos = root.Position
    local gl = gateTable()
    local rz
    for id in pairs(gl) do
        local r = zoneRange(id)
        if r and pos.Z <= r.top + 4 and pos.Z >= r.bottom - 4 then
            if not rz or (r.top - r.bottom) < (rz.top - rz.bottom) then rz = r end
        end
    end
    local tz = pt.Z
    if rz then tz = math.clamp(pt.Z, rz.bottom + 4, rz.top - 4) end
    local goal = Vector3.new(pt.X, pos.Y, tz)
    local vec = goal - pos
    local len = vec.Magnitude
    if len < 0.5 then return Vector3.new(pos.X, pos.Y, pos.Z) end
    local dir = vec.Unit
    local best = len
    local perp = Vector3.new(-dir.Z, 0, dir.X) * 1.4
    for _, off in ipairs({Vector3.new(0, 0, 0), perp, -perp}) do
        for _, h in ipairs({0.5, 2.5}) do
            local r = cast(pos + off + Vector3.new(0, h - 2, 0), dir * (len + 2))
            if r and r.Normal.Y < 0.55 and r.Distance - 2.2 < best then best = math.max(r.Distance - 2.2, 0) end
        end
    end
    local out = pos + dir * best
    -- ปลายทางต้องมีพื้น (กันตกขอบ)
    if best > 1 and not groundY(out.X, out.Z, pos.Y) then
        for f = 0.7, 0.2, -0.25 do
            local q = pos + dir * (best * f)
            if groundY(q.X, q.Z, pos.Y) then return Vector3.new(q.X, pos.Y, q.Z) end
        end
        return Vector3.new(pos.X, pos.Y, pos.Z)
    end
    return Vector3.new(out.X, pos.Y, out.Z)
end

local function rotY(v, deg)
    local a = math.rad(deg)
    local c, s = math.cos(a), math.sin(a)
    return Vector3.new(v.X * c - v.Z * s, 0, v.X * s + v.Z * c)
end

local function freeDist(pos, dir, maxLen)
    local perp = Vector3.new(-dir.Z, 0, dir.X) * 1.3
    local best = maxLen
    for _, off in ipairs({Vector3.new(0, 0, 0), perp, -perp}) do
        local r = cast(pos + off, dir * maxLen)
        if r and r.Normal.Y < 0.55 and r.Distance < best then best = r.Distance end
    end
    return best
end

local function groundSafe(pos, dir, dist, gy0)
    local p = pos + dir * dist
    local g = groundY(p.X, p.Z, pos.Y)
    return g ~= nil and g >= gy0 - 7 and g <= gy0 + 5
end

local HEADINGS = {0, 25, -25, 50, -50, 80, -80, 110, -110, 140, -140, 180}
local function pickHeading(pos, goalDir, avoid)
    local gy0 = groundY(pos.X, pos.Z, pos.Y) or (pos.Y - 3)
    local best, bestScore
    for _, deg in ipairs(HEADINGS) do
        local d = rotY(goalDir, deg)
        if d.Magnitude > 0.01 then
            d = d.Unit
            local fd = freeDist(pos, d, 14)
            if fd > 3 and groundSafe(pos, d, 4, gy0) then
                local score = fd + goalDir:Dot(d) * 10
                if avoid and avoid:Dot(d) > 0.85 then score = score - 40 end
                if not bestScore or score > bestScore then best, bestScore = d, score end
            end
        end
    end
    return best
end

local function pathWalk(target, budget)
    local root, hum = getRoot(), getHum()
    if not root or not hum then return false end
    local path = PathS:CreatePath({AgentRadius = 2.5, AgentHeight = 5.5, AgentCanJump = false, WaypointSpacing = 5})
    local ok = pcall(function() path:ComputeAsync(root.Position, target) end)
    if not ok or path.Status ~= Enum.PathStatus.Success then return false end
    local t0 = os.clock()
    for _, wp in ipairs(path:GetWaypoints()) do
        if not Farm.on or os.clock() - t0 > budget then return false end
        Drive.point = wp.Position
        local w0 = os.clock()
        while Farm.on and os.clock() - w0 < 2.5 do
            local r = getRoot()
            if not r then return false end
            if horiz(r.Position, wp.Position) < 3.5 then break end
            task.wait(0.1)
        end
    end
    return true
end

local function newNav()
    return {commitDir = nil, commitUntil = 0, lastPos = nil, lastT = 0, lastDir = nil,
        stuckN = 0, avoid = nil, bestLen = math.huge, progT = os.clock(), pathT = 0}
end

local function navStep(st, hum, root, target)
    local now = os.clock()
    local pos = root.Position
    local dx, dz = target.X - pos.X, target.Z - pos.Z
    local len = math.sqrt(dx * dx + dz * dz)
    if len < 0.5 then return nil end
    local goal = Vector3.new(dx / len, 0, dz / len)

    if len < st.bestLen - 4 then
        st.bestLen, st.progT = len, now
    elseif now - st.progT > CFG.StuckFail then
        return "fail"
    end

    if not st.lastPos then
        st.lastPos, st.lastT = pos, now
    elseif now - st.lastT >= 0.7 then
        local moved = horiz(pos, st.lastPos)
        local expect = math.max(hum.WalkSpeed, 8) * (now - st.lastT)
        if moved < expect * 0.25 then
            st.stuckN = st.stuckN + 1
            st.avoid = st.lastDir or goal
            setStatus(string.format("ติด! หลบรอบที่ %d", st.stuckN))
            local base = rotY(goal, (math.random() - 0.5) * 50)
            st.commitDir = pickHeading(pos, base, st.avoid)
            st.commitUntil = now + 0.8 + math.min(st.stuckN, 5) * 0.3
            if st.stuckN % 3 == 0 and now - st.pathT > 4 then
                st.pathT = now
                local reach = math.min(len, 90)
                pathWalk(Vector3.new(pos.X + goal.X * reach, pos.Y, pos.Z + goal.Z * reach), 10)
            end
            if st.stuckN % 5 == 0 then
                st.commitDir = rotY(-goal, (math.random() - 0.5) * 120)
                st.commitUntil = now + 1.2
            end
        else
            st.stuckN = 0
        end
        st.lastPos, st.lastT = pos, now
    end

    local dir
    if st.commitDir and now < st.commitUntil then
        dir = st.commitDir
    else
        st.commitDir = nil
        dir = goal
        local gy0 = groundY(pos.X, pos.Z, pos.Y) or (pos.Y - 3)
        if freeDist(pos, goal, 5) < 3.2 or not groundSafe(pos, goal, 4.5, gy0) then
            local alt = pickHeading(pos, goal, st.avoid)
            if alt then
                dir = alt
                st.commitDir, st.commitUntil = alt, now + 0.5
            end
        end
    end
    st.lastDir = dir
    Drive.point = pos + dir * math.min(len, 12)
    return nil
end

local function walkToInner(target, opts)
    opts = opts or {}
    local stop = opts.stop or 5
    local timeout = opts.timeout or CFG.WalkTimeout
    local t0 = os.clock()
    local st = newNav()
    local lastStream = 0
    while Farm.on and os.clock() - t0 < timeout do
        local root, hum = getRoot(), getHum()
        if not root or not hum or hum.Health <= 0 then return false, "dead" end
        if hum.Sit then hum.Sit = false end
        local pos = root.Position
        local len = horiz(pos, target)
        if len <= stop then return true end
        if opts.abort and opts.abort() then return true, "abort" end
        -- โหมดบอส: ถ้ามีบอสเกิดระหว่างเดินฟามเวล ให้หยุดเดินไปตีบอสก่อน
        if not Farm.inBoss and X.bossNeeded() then return false, "preempt" end
        if os.clock() - lastStream > 2.5 then
            lastStream = os.clock()
            local reach = math.min(len, 150)
            local far = Vector3.new(pos.X + (target.X - pos.X) / len * reach, pos.Y, pos.Z + (target.Z - pos.Z) / len * reach)
            task.spawn(function() pcall(function() LP:RequestStreamAroundAsync(far) end) end)
        end
        if navStep(st, hum, root, target) == "fail" then return false, "stuck" end
        task.wait(0.1)
    end
    return false, "timeout"
end

local function walkTo(target, opts)
    local ok, why = walkToInner(target, opts)
    Drive.point = nil
    return ok, why
end

--==================================================================
-- แท่นวาป (Warp Pillar)
--==================================================================
local function promptPos(prompt)
    local p = prompt and prompt.Parent
    if not p then return nil end
    if p:IsA("BasePart") then return p.Position end
    if p:IsA("Attachment") then return p.WorldPosition end
    local ok, cf = pcall(function() return p:GetPivot() end)
    if ok and cf then return cf.Position end
    return nil
end

local function unlockedPillars()
    local set = {Town = true}
    local raw = LP:GetAttribute("WarpPillars")
    if type(raw) == "string" then
        for id in raw:gmatch("[%w_]+") do set[id] = true end
    end
    return set
end

local function allPillarIds()
    local ids, seen = {}, {}
    local function add(id)
        if type(id) == "string" and not seen[id] then
            seen[id] = true
            ids[#ids + 1] = id
        end
    end
    add("Town")
    for id in pairs(GATE_FALLBACK) do
        if id:match("^Boss%d+$") then add(id) end
    end
    local map = workspace:FindFirstChild("Map")
    local folder = map and map:FindFirstChild("WarpPillars")
    if folder then
        for _, m in ipairs(folder:GetChildren()) do add(m:GetAttribute("WarpId")) end
    end
    table.sort(ids)
    return ids
end

local function pillarInfo(id)
    local map = workspace:FindFirstChild("Map")
    local folder = map and map:FindFirstChild("WarpPillars")
    local model = folder and folder:FindFirstChild("WarpPillar_" .. id)
    local prompt = model and model:FindFirstChild("WarpPrompt", true)
    local pos = prompt and promptPos(prompt) or nil
    if not pos and model then
        local ok, cf = pcall(function() return model:GetPivot() end)
        if ok and cf and cf.Position.Magnitude > 5 then pos = cf.Position end
    end
    if not pos then pos = PILLAR_FALLBACK[id] end
    if not pos then
        local g = gateTable()[id]
        if g then pos = Vector3.new(PILLAR_X, 0, g.z + PILLAR_OFFSET) end
    end
    if not pos then return nil end
    return {id = id, pos = pos, prompt = prompt, model = model}
end

local function triggerPrompt(prompt, useKey)
    if not prompt then return false end
    if not useKey and typeof(fireproximityprompt) == "function" then
        if pcall(fireproximityprompt, prompt) then return true end
    end
    if VIM then
        return pcall(function()
            VIM:SendKeyEvent(true, Enum.KeyCode.E, false, game)
            task.wait(math.max(0.1, (prompt.HoldDuration or 0) + 0.1))
            VIM:SendKeyEvent(false, Enum.KeyCode.E, false, game)
        end)
    end
    return false
end

do
    local ev = RemotesFolder and RemotesFolder:FindFirstChild("PillarOpen")
    if ev and ev:IsA("RemoteEvent") then
        bind(ev.OnClientEvent, function(id) Farm.pillarOpen = id or true end)
    end
end

local function closePillarGui()
    local g = PG:FindFirstChild("HuntWarpPillar")
    local btn = g and g:FindFirstChild("Close", true)
    if btn and btn:IsA("GuiButton") then clickGui(btn) end
end

local function goToPillar(id)
    local t0 = os.clock()
    local nearSince = nil
    while Farm.on and os.clock() - t0 < 60 do
        local p = pillarInfo(id)
        local root = getRoot()
        if not p or not root then return nil end
        if p.prompt then
            local pp = promptPos(p.prompt)
            local range = (p.prompt.MaxActivationDistance or 12) - 3
            if pp and (root.Position - pp).Magnitude <= range then return p end
            if pp and horiz(root.Position, pp) <= 5 then
                nearSince = nearSince or os.clock()
                if os.clock() - nearSince > 3 then return p end
            else
                nearSince = nil
            end
        elseif horiz(root.Position, p.pos) <= 6 then
            nearSince = nearSince or os.clock()
            if os.clock() - nearSince > 6 then return nil end
        end
        local _, why = walkTo(p.pos, {stop = 4, timeout = 8})
        if why == "dead" or why == "preempt" then return nil end
        task.wait(0.1)
    end
    return nil
end

local function openPillar(p)
    for attempt = 1, 3 do
        Farm.pillarOpen = nil
        triggerPrompt(p.prompt, attempt >= 2)
        local t0 = os.clock()
        while os.clock() - t0 < 2.5 do
            if Farm.pillarOpen then return true end
            task.wait(0.1)
        end
    end
    return false
end

local function movedFrom(pos0, timeout)
    local t0 = os.clock()
    while os.clock() - t0 < timeout do
        local r = getRoot()
        if r and (r.Position - pos0).Magnitude > 40 then return true end
        task.wait(0.2)
    end
    return false
end

local function pillarWarp(board, land)
    local p = goToPillar(board.id)
    if not p then return false end
    if not openPillar(p) then return false end
    local root = getRoot()
    if not root then return false end
    local start = root.Position
    fire("PillarWarp", land.id)
    local ok = movedFrom(start, 5)
    if not ok then closePillarGui() end
    return ok
end

-- วาปไปแท่นที่ใกล้จุดหมายที่สุด (ถ้าช่วยลดระยะได้ และแท่นนั้นปลดล็อกแล้ว) minZ = ห้ามลงเลยค่านี้
local function warpToward(dest, saving, minZ, allowTown)
    local root = getRoot()
    if not root then return false end
    if (tonumber(LP:GetAttribute("Silver")) or 0) < CFG.WarpCost then return false end
    local unlocked, now = unlockedPillars(), os.clock()
    local land, landD, board, boardD
    for _, id in ipairs(allPillarIds()) do
        local p = pillarInfo(id)
        if p and unlocked[id] then
            local b = Farm.pillarBlock[id]
            local d1 = horiz(p.pos, dest)
            if (id ~= "Town" or allowTown) and not (b and b > now) and (not minZ or p.pos.Z >= minZ) then
                if not landD or d1 < landD then land, landD = p, d1 end
            end
            local d2 = horiz(root.Position, p.pos)
            if not boardD or d2 < boardD then board, boardD = p, d2 end
        end
    end
    if not land or not board or land.id == board.id then return false end
    if boardD + landD + (saving or 0) >= horiz(root.Position, dest) then return false end
    setStatus(string.format("วิ่งไปแท่น %s วาปไป %s", board.id, land.id))
    if pillarWarp(board, land) then
        task.wait(0.8)
        return true
    end
    Farm.pillarBlock[land.id] = os.clock() + 120
    return false
end

local function registerRoute(r)
    if not CFG.RegisterPillars then return end
    local root = getRoot()
    if not root then return end
    local pz = root.Position.Z
    local unlocked = unlockedPillars()
    local list = {}
    for _, id in ipairs(allPillarIds()) do
        if id ~= "Town" and not unlocked[id] and not Farm.activated[id] then
            local info = pillarInfo(id)
            if info and info.pos.Z <= pz and info.pos.Z >= r.bottom - 5 then
                list[#list + 1] = info
            end
        end
    end
    table.sort(list, function(a, b) return a.pos.Z > b.pos.Z end)
    for _, info in ipairs(list) do
        if not Farm.on or (not Farm.inBoss and X.bossNeeded()) then return end
        Farm.activated[info.id] = true
        setStatus("แวะกดเก็บแท่นวาป " .. info.id)
        local p = goToPillar(info.id)
        if p and openPillar(p) then
            task.wait(0.4)
            closePillarGui()
        end
    end
end

--==================================================================
-- เลือกด่านตามเลเวล + เดินทางไปด่าน
--==================================================================
local function pickZone(lv)
    local idx = 1
    for i, z in ipairs(CFG.ZONES) do
        if lv >= z.minLevel then idx = i end
    end
    local now = os.clock()
    for i = idx, 1, -1 do
        local z = CFG.ZONES[i]
        local untilT = Farm.blocked[z.id]
        if not (untilT and untilT > now) then return z end
    end
    return CFG.ZONES[1]
end

-- จุดกลางโซนมอน: ใช้ตำแหน่งชิ้นโซนจริงถ้าอยู่ในช่วงของด่าน ไม่งั้นใช้กลางช่วง Z ของด่าน
local function zoneCenter(id)
    local r = zoneRange(id)
    if not r then return nil end
    local zs = workspace:FindFirstChild("Zones")
    local part = zs and zs:FindFirstChild(id)
    if part and part:IsA("BasePart") then
        local p = part.Position
        if p.Z <= r.top and p.Z >= r.bottom then return Vector3.new(p.X, p.Y, p.Z) end
    end
    return Vector3.new(r.x, 0, (r.top + r.bottom) / 2)
end

local function travelToZone(zone)
    local r = zoneRange(zone.id)
    if not r then return false end
    local len = r.top - r.bottom
    local destZ = r.top - math.min(40, len * 0.25)
    local dest = Vector3.new(r.x, 0, destZ)           -- จุดใกล้ปากโซน ใช้เทียบ/วาป
    local center = zoneCenter(zone.id) or dest         -- จุดกลางโซนมอน ต้องเดินให้ถึงตรงนี้เพื่อให้มอนโหลด

    stopBot()

    warpToward(dest, CFG.PillarMinSaving, r.bottom - 5)
    if not Farm.on then return false end

    local root = getRoot()
    if root and deepIn(root.Position, zone.id) then return true end

    registerRoute(r)
    if not Farm.on then return false end

    setStatus("เดินขึ้นไปโซนมอน " .. zone.id)
    -- เดินจนถึงกลางโซนจริง ไม่หยุดแค่บันไดทางขึ้น (วนซ้ำถ้ายังไม่ลึกพอ)
    for _ = 1, 3 do
        local ok = walkTo(center, {stop = 12})
        if not Farm.on then return false end
        root = getRoot()
        if root and deepIn(root.Position, zone.id) then return true end
        if not ok then break end
    end
    root = getRoot()
    return root ~= nil and deepIn(root.Position, zone.id)
end

--==================================================================
-- มอนสเตอร์ในโซน + วิ่งไล่
--==================================================================
local function monsterAlive(m)
    if not m or not m.Parent then return false end
    local hp = m:GetAttribute("HP")
    return type(hp) == "number" and hp > 0
end

local function monsterPos(m)
    local ok, cf = pcall(function() return m:GetPivot() end)
    if ok and cf then return cf.Position end
    return nil
end

local function nearestMonster(fromPos, maxDist, zoneId, withBoss)
    local folder = workspace:FindFirstChild("Monsters")
    if not folder then return nil end
    local r = zoneRange(zoneId)
    local now = os.clock()
    local best, bestD = nil, maxDist
    for _, m in ipairs(folder:GetChildren()) do
        local sk = Farm.skip[m]
        if m:IsA("Model") and monsterAlive(m) and not (sk and sk > now)
            and (withBoss or not m:GetAttribute("IsBoss")) and not m:GetAttribute("IsMiniBoss") and not m:GetAttribute("IsLeader") then
            local threat = m:GetAttribute("ThreatUserId")
            if threat == nil or threat == 0 or threat == LP.UserId then
                local mp = monsterPos(m)
                if mp then
                    local okZone = true
                    if r then
                        okZone = mp.Z <= r.top - CFG.ZoneMargin and mp.Z >= r.bottom + CFG.ZoneMargin
                    end
                    if okZone then
                        local d = horiz(fromPos, mp)
                        if d < bestD then best, bestD = m, d end
                    end
                end
            end
        end
    end
    return best
end

local function chase(zone)
    local deadline = os.clock() + CFG.EngageTimeout
    local done = false
    -- ถ้ายังไม่เห็นมอน (ยังไม่โหลด/อยู่ไกล) เดินสำรวจในโซน: กลางโซน -> ต้นโซน -> ท้ายโซน จนกว่าจะเจอ
    local zr = zoneRange(zone.id)
    local explore = {}
    if zr then
        explore[1] = zoneCenter(zone.id)
        -- กวาดตลอดความยาวโซน เริ่มจากลึกจากปากโซนลงไปทีละ SweepStep
        local z = zr.top - CFG.EnterDepth
        while z > zr.bottom + 20 do
            explore[#explore + 1] = Vector3.new(zr.x, 0, z)
            z = z - CFG.SweepStep
        end
        explore[#explore + 1] = Vector3.new(zr.x, 0, zr.bottom + 20)
    end
    local exI, noneSince = 0, nil
    while Farm.on and os.clock() < deadline do
        local root, hum = getRoot(), getHum()
        if not root or not hum or hum.Health <= 0 then break end
        if hum.Sit then hum.Sit = false end
        local m = nearestMonster(root.Position, CFG.SearchRadius, zone.id)
        if not m then
            Drive.point = nil
            noneSince = noneSince or os.clock()
            if os.clock() - noneSince > 1.5 and exI < #explore then
                exI = exI + 1
                setStatus("ยังไม่เจอมอน เดินหาในโซน " .. zone.id)
                walkTo(explore[exI], {stop = 10, timeout = 25, abort = function()
                    local rr = getRoot()
                    return rr ~= nil and nearestMonster(rr.Position, CFG.SearchRadius, zone.id) ~= nil
                end})
                deadline = os.clock() + CFG.EngageTimeout
                noneSince = nil
            else
                task.wait(0.4)
            end
        else
            local reachDist = math.clamp(attackRange() * 0.6, 3, 18)
            local t0 = os.clock()
            local st = newNav()
            local reached = false
            while Farm.on and os.clock() - t0 < CFG.ChaseTimeout and monsterAlive(m) do
                local r2, h2 = getRoot(), getHum()
                local mp = monsterPos(m)
                if not r2 or not h2 or not mp then break end
                if horiz(r2.Position, mp) <= reachDist then
                    reached = true
                    break
                end
                if navStep(st, h2, r2, mp) == "fail" then break end
                task.wait(0.1)
            end
            Drive.point = nil
            if reached and monsterAlive(m) then
                startBot(m)
                done = true
                break
            end
            Farm.skip[m] = os.clock() + CFG.SkipTime
        end
    end
    Drive.point = nil
    return done
end

-- ประตูห้องบอส: ต้องตีบอสในห้อง (โซน Boss01..04) ให้ตายก่อนถึงจะผ่านไปด่านถัดไปได้
local BOSS_ROOMS = {"Boss01", "Boss02", "Boss03", "Boss04"}
local function gateCleared(id)
    local raw = LP:GetAttribute("BossGatesJson")
    if type(raw) ~= "string" or raw == "" then return false end
    local ok, j = pcall(function() return HttpS:JSONDecode(raw) end)
    return ok and type(j) == "table" and j[id] == true
end
-- เลเวลที่ป้ายล็อก BossLock_<ฟิลด์> ต้องการ (เช่น "Lv.25") หรือ nil
local function barrierLevel(id)
    local map = workspace:FindFirstChild("Map")
    local bar = map and map:FindFirstChild("Barriers")
    local lock = bar and bar:FindFirstChild("BossLock_" .. id)
    local txt = lock and lock:GetAttribute("LockText")
    if type(txt) ~= "string" then return nil end
    local lv = txt:match("Lv%.?%s*(%d+)")
    return lv and tonumber(lv) or nil
end

-- ห้องบอสนี้ "ไปถึงได้แล้วหรือยัง": (1) ผ่านประตูห้องบอสก่อนหน้าครบ (2) เลเวลถึงที่ป้ายล็อกก่อนถึงห้องนี้กำหนด
-- คืน true หรือ false, เหตุผล  (ไม่ผ่าน = ห้ามวิ่งไปหา ให้ไปฟามเลเวลแทน)
local function roomAccess(gid)
    local gl = gateTable()
    local me = gl[gid]
    if not me then return false, "ไม่พบห้อง" end
    local raw = LP:GetAttribute("BossGatesJson")
    if type(raw) == "string" and raw ~= "" then
        for _, id in ipairs(BOSS_ROOMS) do
            if id == gid then break end
            if gl[id] and gl[id].z > me.z and not (Farm.gateDone[id] or gateCleared(id)) then
                return false, "ต้องผ่านประตู " .. id .. " ก่อน"
            end
        end
    end
    local fid, fz
    for id, v in pairs(gl) do
        if id:match("^Field%d+$") and v.z > me.z and (not fz or v.z < fz) then fid, fz = id, v.z end
    end
    local need = fid and barrierLevel(fid)
    local lv = tonumber(LP:GetAttribute("Level"))
    if need and lv and lv < need then return false, "ต้อง Lv." .. need end
    return true
end

-- คืนชื่อห้องบอสที่ยังต้องผ่าน (อยู่ระหว่างเรากับด่านเป้าหมาย) หรือ nil
local function gateBossPending(zone)
    local zr, root = zoneRange(zone.id), getRoot()
    if not zr or not root then return nil end
    local pz = root.Position.Z
    for _, id in ipairs(BOSS_ROOMS) do
        local ar = zoneRange(id)
        if ar and zr.top <= ar.bottom + 2 and pz > ar.bottom + 5
            and not Farm.gateDone[id] and not gateCleared(id) then
            return id
        end
    end
    return nil
end

local function farmStep()
    local root, hum = getRoot(), getHum()
    if not root or not hum or hum.Health <= 0 then
        setStatus("รอตัวละคร")
        return
    end
    local lv = tonumber(LP:GetAttribute("Level"))
    if not lv then
        setStatus("อ่านเลเวลไม่ได้")
        return
    end

    refreshZones()
    local zone = pickZone(lv)
    -- เข้าโซนครั้งแรกต้องลึกพอ (deepIn) แต่พอเข้ามาแล้วให้เผื่อขอบ StayMargin กันเดินกลับไปกลับมา
    local here
    if Farm.zone == zone.id then
        here = inZone(root.Position, zone.id, CFG.StayMargin)
    else
        here = deepIn(root.Position, zone.id)
    end

    if not here then
        local gid = gateBossPending(zone)
        if gid then
            local okA, why = roomAccess(gid)
            if not okA then
                -- ห้องบอสขวางทางแต่ยังไปไม่ได้ ห้ามวิ่งไปชน: พักด่านนี้ไว้ แล้วฟามด่านก่อนหน้าไปก่อน
                Farm.blocked[zone.id] = os.clock() + 120
                setStatus(string.format("ห้อง %s ยังไปไม่ได้ (%s) ฟามด่านก่อนหน้า", gid, tostring(why)))
                return
            end
            if X.clearGate and X.clearGate(gid) then return end -- ตีบอสห้องบอสแล้ว วนรอบใหม่
        end
        setStatus(string.format("เดินทางไปด่าน %s (Lv %d)", zone.id, lv))
        local ok = travelToZone(zone)
        if not Farm.on then return end
        if ok then
            Farm.zone = zone.id
            Farm.primed = false
            Farm.engageTries = 0
        else
            if not Farm.inBoss and X.bossNeeded() then return end -- ถูกบอสขัดจังหวะ ไม่ใช่ไปไม่ถึง
            Farm.blocked[zone.id] = os.clock() + 90
            setStatus("ไปไม่ถึงด่าน ลองด่านก่อนหน้า")
            return
        end
    elseif Farm.zone ~= zone.id then
        Farm.zone = zone.id
        Farm.primed = false
        Farm.engageTries = 0
    end

    if not Farm.primed then
        setStatus("วิ่งไปหามอนและกด F 1 ที")
        local ok = chase(zone)
        Farm.engageTries = Farm.engageTries + 1
        -- เจอมอนและกดตีแล้วเท่านั้นถึงนับว่าเริ่มแล้ว (เดิมยอมแพ้หลัง 3 รอบ ทำให้ยืนค้างที่บันได)
        if ok then Farm.primed, Farm.noMonSince = true, nil end
    else
        -- ตรวจว่าใกล้ตัวยังมีมอนไหม ถ้าหายไปนานเกิน NoMonWait ให้กลับไปสำรวจโซนต่อ
        local r2 = getRoot()
        if r2 and nearestMonster(r2.Position, CFG.NearRadius, zone.id) then
            Farm.noMonSince = nil
        else
            Farm.noMonSince = Farm.noMonSince or os.clock()
            if os.clock() - Farm.noMonSince > CFG.NoMonWait then
                Farm.noMonSince, Farm.primed = nil, false
                setStatus("ไม่มีมอนใกล้ตัว เดินสำรวจโซนต่อ")
                return
            end
        end
    end

    if botOn() then
        Farm.offSince = nil
        Farm.warnedBot = false
        setStatus(string.format("ฟาม %s | Lv %d | บอททำงาน", Farm.zone or zone.id, lv))
    else
        Farm.offSince = Farm.offSince or os.clock()
        if os.clock() - Farm.offSince >= 2 and os.clock() - Farm.lastPress >= 6 then
            Farm.lastPress = os.clock()
            setStatus("เปิดบอทเกม")
            if not startBot(nil) and not Farm.warnedBot then
                Farm.warnedBot = true
                Toast("เปิดบอทเกมอัตโนมัติไม่ได้ กดปุ่ม Auto ของเกมเอง")
            end
        end
    end
end

Farm.wantOn, Farm.runToken, Farm.starting, Farm.prefix = false, nil, false, ""

local function farmLoopBody()
    -- มีกล่องดรอปอยู่ใกล้ ๆ (มอน/บอสตายแล้ว) ไปกด E เปิดก่อน
    if not Farm.inBoss then Loot.collect() end
    if not Farm.on then return end
    if Farm.mode == "boss" and Farm.target and X.findBoss then
        local okA, why = roomAccess(Farm.target.gate)
        if not okA then
            -- ห้องที่เลือกยังไปไม่ได้ ไม่วิ่งไปหา ฟามเลเวลตามปกติไปก่อน
            Farm.prefix = string.format("[%s ล็อก: %s] ", tostring(Farm.target.name), tostring(why))
            farmStep()
            return
        end
        Farm.prefix = ""
        local b = X.findBoss(Farm.target)
        if b then X.doBoss(b) else X.waitAtRoom(Farm.target) end -- ไม่ฟามมอนปกติ
        return
    elseif Farm.mode == "bossall" and X.bossAllStep then
        Farm.prefix = ""
        X.bossAllStep()
        return
    end
    Farm.prefix = ""
    farmStep()
end

function Farm.start()
    Farm.wantOn = true
    if Farm.on or Farm.starting then return end
    Farm.starting = true
    task.spawn(function()
        -- รอเธรดฟามรอบก่อนหน้าจบก่อน (กันซ้อนกันตอนปิดแล้วเปิดไว / เปลี่ยนโหมด)
        local t0 = os.clock()
        while Farm.runToken and os.clock() - t0 < 8 do task.wait(0.05) end
        Farm.starting = false
        if not Farm.wantOn or Farm.on or not gui.Parent then return end
        Farm.on = true
        Farm.token = Farm.token + 1
        Farm.zone, Farm.primed, Farm.engageTries, Farm.inBoss = nil, false, 0, false
        Farm.noMonSince = nil
        Farm.blocked, Farm.offSince, Farm.warnedBot = {}, nil, false
        Farm.skip, Farm.pillarBlock, Farm.activated, Farm.bossSkip, Farm.gateDone = {}, {}, {}, {}, {}
        Farm.waitGate = nil
        local token = Farm.token
        Farm.runToken = token
        while Farm.on and Farm.token == token and gui.Parent do
            local ok, err = pcall(farmLoopBody)
            if not ok then
                Farm.inBoss = false
                Drive.point = nil
                warn("[JustHub] AutoFarm: " .. tostring(err))
            end
            local w = 0
            while w < CFG.LoopInterval and Farm.on and Farm.token == token do
                task.wait(0.1)
                w = w + 0.1
            end
        end
        if Farm.runToken == token then Farm.runToken = nil end
    end)
end

function Farm.stop()
    Farm.wantOn = false
    Farm.on = false
    Drive.point = nil
    Farm.prefix = ""
    local hum = getHum()
    local root = getRoot()
    if hum and root then hum:MoveTo(root.Position) end
    setStatus("ปิด")
end

-- เปลี่ยนโหมด/เป้าหมายแล้วให้มีผลทันที: หยุดรอบเดิมแล้วเริ่มใหม่ ไม่ต้องกดปิด-เปิด Auto Farm
function Farm.restart()
    if not Farm.wantOn then return end
    Farm.on = false
    Drive.point = nil
    Dodge.untilT = 0
    Farm.start()
end

--==================================================================
-- หลบ+แดช / บอสรูม / ฟามบอส
--==================================================================
do
    local T = {dodge = true, lastDash = 0}
    X.T = T
    local function R(n) return RemotesFolder and RemotesFolder:FindFirstChild(n) end

    ---------------- หลบ + แดช ----------------
    local function inShape(pos, s)
        if s.Kind == "circle" and typeof(s.Center) == "Vector3" then
            return horiz(pos, s.Center) <= (s.Radius or 0) + (s.Reach or 0) + 1
        elseif s.Kind == "box" and typeof(s.CFrame) == "CFrame" then
            local lp = s.CFrame:PointToObjectSpace(pos)
            return math.abs(lp.X) <= (s.Width or 0) / 2 + (s.Reach or 0) + 1
                and math.abs(lp.Z) <= (s.Length or 0) + 1
        end
        return false
    end
    local function inAny(pos, shapes)
        for _, s in pairs(shapes) do
            if type(s) == "table" and s.Safe ~= true and not s.Room and inShape(pos, s) then return true end
        end
        return false
    end
    local function escapePoint(pos, s, all)
        local c = {}
        if s.Kind == "circle" then
            local d = Vector3.new(pos.X - s.Center.X, 0, pos.Z - s.Center.Z)
            if d.Magnitude < 0.5 then d = Vector3.new(1, 0, 0) end
            d = d.Unit
            local far = (s.Radius or 0) + (s.Reach or 0) + 4
            for _, deg in ipairs({0, 40, -40, 80, -80, 180}) do c[#c + 1] = s.Center + rotY(d, deg) * far end
        else
            local lp = s.CFrame:PointToObjectSpace(pos)
            local sx = lp.X >= 0 and 1 or -1
            local off = (s.Width or 0) / 2 + (s.Reach or 0) + 4
            c[1] = s.CFrame:PointToWorldSpace(Vector3.new(sx * off, lp.Y, lp.Z))
            c[2] = s.CFrame:PointToWorldSpace(Vector3.new(-sx * off, lp.Y, lp.Z))
        end
        -- เลือกจุดที่มีพื้น และไม่ไปตกในวง/กล่องอื่นของท่าเดียวกัน (เช่น Boulder Rain มีหลายวง)
        for _, p in ipairs(c) do
            if groundY(p.X, p.Z, pos.Y) and not (all and inAny(p, all)) then return p end
        end
        for _, p in ipairs(c) do
            if groundY(p.X, p.Z, pos.Y) then return p end
        end
        return nil
    end
    local function dashTo(pt, dur)
        local root = getRoot()
        local okc, cp = pcall(clampDodge, root, pt)
        if okc and cp then pt = cp end
        Dodge.pt, Dodge.untilT = pt, os.clock() + dur
        if root and horiz(root.Position, pt) < 3 then return end -- ชนกำแพง/ขอบโซน ไม่แดชซ้ำ
        if os.clock() - T.lastDash > 1 then
            T.lastDash = os.clock()
            task.delay(0.12, function() fire("Dash") end)
        end
    end

    ---------------- วงสีเขียว = จุดปลอดภัยของสกิลวงกว้างในห้องบอส ----------------
    local function isGreen(c) return c.G > 0.5 and c.G > c.R * 1.4 and c.G > c.B * 1.4 end
    local ovp = OverlapParams.new()
    -- หาชิ้นส่วนสีเขียวแบน ๆ (เอฟเฟกต์วงปลอดภัย) ใกล้ตัว คืนชิ้นที่ใกล้สุด
    local function findGreenZone(origin)
        local ex = {}
        for _, p in ipairs(Players:GetPlayers()) do if p.Character then ex[#ex + 1] = p.Character end end
        local mf = workspace:FindFirstChild("Monsters")
        if mf then ex[#ex + 1] = mf end
        ovp.FilterType = Enum.RaycastFilterType.Exclude
        ovp.FilterDescendantsInstances = ex
        local best, bd
        for _, p in ipairs(workspace:GetPartBoundsInRadius(origin, 160, ovp)) do
            if p:IsA("BasePart") and not p.CanCollide and p.Transparency < 0.97 and isGreen(p.Color) then
                local s = p.Size
                local w = math.max(s.X, s.Y, s.Z)
                if w >= 6 and w <= 80 and math.min(s.X, s.Y, s.Z) <= 3 then
                    local d = horiz(origin, p.Position)
                    if not bd or d < bd then best, bd = p, d end
                end
            end
        end
        return best
    end
    -- วิ่งเข้าไปยืนกลางวงเขียว (ลองหาอยู่ช่วงหนึ่ง เพราะวงอาจโผล่หลังคำเตือนนิดหน่อย)
    local function seekSafe(dur)
        task.spawn(function()
            local t0 = os.clock()
            while os.clock() - t0 < math.max(dur, 1.5) do
                local root = getRoot()
                if not root then return end
                local z = findGreenZone(root.Position)
                if z then
                    local c = z.Position
                    local pt = Vector3.new(c.X, root.Position.Y, c.Z)
                    if horiz(root.Position, c) > 14 and os.clock() - T.lastDash > 1 then
                        dashTo(pt, 0.6)
                    else
                        Dodge.pt, Dodge.untilT = pt, os.clock() + 0.5
                    end
                end
                task.wait(0.1)
            end
        end)
    end

    -- ท่าบอสที่เกมเตือน (BossFx "warn" = วงกลม/กล่อง)
    --  * มีรูปที่ระบุว่าเป็นจุดปลอดภัย (Safe / Kind มีคำว่า safe / สีเขียว) -> วิ่งไปยืนกลางรูปนั้น
    --  * สกิลวงกว้างมาก (วงใหญ่เกินกว่าจะวิ่งหนีออก) -> หาวงเขียวแล้วเข้าไปยืน
    --  * ท่าปกติ ถ้ายืนอยู่ในรูป วิ่งหนีออก + แดช
    -- ข้อมูลจริงจากเกม (Gorilla King / Jungle Roar):
    --   shape 1 = กล่องใหญ่ทั้งห้อง Room=true (ยืนในนี้ = ตาย)
    --   shape 2..4 = วงกลม Safe=true รัศมี 9 (จุดปลอดภัย = วงเขียว)
    --   ท่าอื่น ๆ ทุกรูปเป็นสีเขียวอ่อนเหมือนกันหมด (150,255,130) แต่เป็น "โซนอันตราย" -> ห้ามใช้สีตัดสินว่าปลอดภัย
    --   ใช้ได้เฉพาะ Safe == true (หรือ Kind มีคำว่า safe) เท่านั้น
    local function dodgeOn() return T.dodge or Farm.inBoss end
    local function isSafeShape(s)
        if type(s) ~= "table" then return false end
        return s.Safe == true or tostring(s.Kind or ""):lower():find("safe") ~= nil
    end
    local function nearestSafe(shapes, pos)
        local best, bd
        for _, s in pairs(shapes) do
            if isSafeShape(s) and typeof(s.Center) == "Vector3" then
                local dd = horiz(pos, s.Center)
                if not bd or dd < bd then best, bd = s, dd end
            end
        end
        return best
    end
    local function goSafe(s, root, hold)
        local c = s.Center
        local pt = Vector3.new(c.X, root.Position.Y, c.Z)
        if horiz(root.Position, c) > math.max((s.Radius or 8) * 0.5, 3) and os.clock() - T.lastDash > 1 then
            dashTo(pt, hold)
        else
            Dodge.pt, Dodge.untilT = pt, os.clock() + hold
        end
    end

    local bf = R("BossFx")
    if bf then bind(bf.OnClientEvent, function(kind, boss, skill, shapes, dur)
        if not dodgeOn() or type(shapes) ~= "table" then return end
        local root = getRoot()
        if not root then return end
        local safe = nearestSafe(shapes, root.Position)
        -- มีวงเขียว (Safe) ในอีเวนต์ไหนก็ตาม ของบอสตัวไหนก็ตาม = ไปยืนทันที
        if safe and kind ~= "warn" and kind ~= "hit" then
            goSafe(safe, root, 1.5)
            return
        end
        if kind ~= "warn" and kind ~= "hit" then return end
        if kind == "hit" then
            -- ตอนท่าตี (hit) ให้ยืนอยู่ในวงเขียวต่อจนท่าจบ
            if safe then goSafe(safe, root, 0.8) end
            return
        end
        local d = tonumber(dur) or 1.5
        if safe then
            goSafe(safe, root, d + 1.0)   -- ท่าวงกว้าง: ไปยืนกลางวงเขียวที่ใกล้ที่สุด แล้วค้างไว้
            return
        end
        local wide = false
        for _, s in pairs(shapes) do
            if type(s) == "table" and (s.Room or (s.Radius or 0) > 45 or (s.Length or 0) > 90 or (s.Width or 0) > 70) then
                wide = true
            end
        end
        -- วงกว้างแต่เกมไม่ส่งข้อมูล Safe มา -> หาชิ้นส่วนสีเขียวในฉากแทน
        if wide then seekSafe(d + 0.5) return end
        -- ท่าปกติ: ถ้ายืนอยู่ในรูปอันตราย วิ่งหนีออก (เลือกจุดที่ไม่ไปตกรูปอื่นของท่าเดียวกัน) + แดช
        for _, s in pairs(shapes) do
            if type(s) == "table" and inShape(root.Position, s) then
                local p = escapePoint(root.Position, s, shapes)
                if p then
                    dashTo(p, d + 0.5)
                    return
                end
            end
        end
    end) end

    -- เลือดตกเร็ว (>=12% ในช่วงสั้น ๆ) = แดชถอยจากมอนที่ใกล้สุด
    task.spawn(function()
        local lastHp
        while gui.Parent do
            task.wait(0.15)
            local h, root = getHum(), getRoot()
            if h and root and dodgeOn() then
                local hp = h.Health
                if lastHp and lastHp - hp >= h.MaxHealth * 0.12 and os.clock() - T.lastDash > 2 then
                    local m = nearestMonster(root.Position, 25, nil, true)
                    local mp = m and monsterPos(m)
                    if mp then
                        local away = Vector3.new(root.Position.X - mp.X, 0, root.Position.Z - mp.Z)
                        if away.Magnitude < 0.5 then away = Vector3.new(1, 0, 0) end
                        local pt = root.Position + away.Unit * 14
                        if groundY(pt.X, pt.Z, root.Position.Y) then dashTo(pt, 0.7) end
                    end
                end
                lastHp = hp
            end
        end
    end)

    ---------------- รายชื่อบอสรูม (มี 4 ห้อง) ----------------
    -- ชื่อ/เลเวลอ่านจากป้ายหน้าประตูก่อน ถ้าป้ายยังไม่โหลดใช้ค่าจากหน้า Index ของเกม
    local ROOM_NAMES = {Boss01 = "Gorilla King Lv.25", Boss02 = "Whitefang Sabertooth Lv.50",
        Boss03 = "Obsidian Pharaoh Lv.75", Boss04 = "Tempest Dragon King Lv.99"}
    local function roomName(id)
        local map = workspace:FindFirstChild("Map")
        local gates = map and map:FindFirstChild("Gates")
        local g = gates and gates:FindFirstChild("Gate_" .. id)
        local sub = g and g:FindFirstChild("Sub", true)
        local raw = sub and sub:IsA("TextLabel") and sub.Text or ""
        if not raw:match("Lv") then raw = ROOM_NAMES[id] or id end
        local lv = raw:match("Lv%.?%s*(%d+)")
        local name = raw:gsub("%s*Lv%.?%s*%d+", ""):gsub("%s+", " ")
        name = name:gsub("^%s+", ""):gsub("%s+$", "")
        return name, lv
    end
    -- หา id บอสในข้อมูลโลก (BossAlive_<id>) จากชื่อ เช่น "Obsidian Pharaoh" -> bigboss_obsidian_pharaoh
    local function roomMid(name)
        local key = name:lower():gsub("%s+", "_")
        for k in pairs(workspace:GetAttributes()) do
            local mid = k:match("^BossAlive_(.+)$")
            if mid and mid:find(key, 1, true) then return mid end
        end
        return nil
    end
    -- เวลาเกิด: -1 = บอสยังอยู่ (ไม่มีเวลา) | >0 = วินาทีที่เหลือ | 0 = กำลังเกิด | nil = ไม่มีข้อมูล
    local function roomLeft(e)
        local mid = roomMid(e.name)
        if mid then
            local alive = workspace:GetAttribute("BossAlive_" .. mid)
            if alive == true then return -1 end
            local left = (tonumber(workspace:GetAttribute("BossNext_" .. mid)) or 0) - workspace:GetServerTimeNow()
            if left > 0 then return left end
            if alive == false then return 0 end
        end
        if X.findBoss(e) then return -1 end
        return nil
    end
    X.roomLeft = roomLeft
    local function roomStatus(e)
        local left = roomLeft(e)
        if left == nil then return "" end
        if left < 0 then return "เกิดอยู่" end
        if left == 0 then return "กำลังเกิด" end
        return string.format("เกิดใน %d:%02d", math.floor(left / 60), math.floor(left % 60))
    end
    X.roomStatus = roomStatus

    X.catalog = function()
        local out = {}
        local map = workspace:FindFirstChild("Map")
        local gates = map and map:FindFirstChild("Gates")
        local gl = gateTable()
        for _, id in ipairs(BOSS_ROOMS) do
            -- มีเฉพาะห้องที่มีอยู่จริง (ถ้าโหลดโฟลเดอร์ประตูแล้ว เช็คจากประตูจริง)
            local exists = gl[id] ~= nil
            if gates and #gates:GetChildren() > 0 then exists = gates:FindFirstChild("Gate_" .. id) ~= nil end
            if exists then
                local name, lv = roomName(id)
                local e = {id = "gate:" .. id, kind = "gate", gate = id, name = name, lv = lv}
                local st = roomStatus(e)
                local okA, why = roomAccess(id)
                if not okA then st = "ล็อก: " .. tostring(why) end   -- ห้องที่ยังไปไม่ได้ แสดงเหตุผลแทนเวลาเกิด
                e.label = name .. (lv and (" Lv." .. lv) or "") .. (st ~= "" and (" · " .. st) or "")
                out[#out + 1] = e
            end
        end
        return out
    end

    -- หาตัวบอสที่ยังมีชีวิตในห้องบอสที่เลือก
    X.findBoss = function(e)
        local folder = workspace:FindFirstChild("Monsters")
        if not folder or not e or not e.gate then return nil end
        local ar = zoneRange(e.gate)
        if not ar then return nil end
        local root = getRoot()
        local from = root and root.Position or Vector3.new(0, 0, 0)
        local now, best, bs = os.clock(), nil, nil
        for _, m in ipairs(folder:GetChildren()) do
            local sk = Farm.bossSkip[m]
            if m:IsA("Model") and monsterAlive(m) and not (sk and sk > now) then
                local mp, pri = monsterPos(m), nil
                if mp and mp.Z <= ar.top and mp.Z >= ar.bottom then
                    if m:GetAttribute("IsBoss") == true then pri = 1
                    elseif m:GetAttribute("IsMiniBoss") == true then pri = 2 end
                    if pri then
                        local sc = pri * 100000 + horiz(from, mp)
                        if not bs or sc < bs then best, bs = m, sc end
                    end
                end
            end
        end
        return best
    end

    local bossCache = {t = 0, v = false}
    X.bossNeeded = function()
        if Farm.mode ~= "boss" or not Farm.target then return false end
        if os.clock() - bossCache.t > 1.2 then
            bossCache.t = os.clock()
            -- ห้องที่ยังไปไม่ได้ ไม่ต้องให้บอสมาขัดจังหวะการฟามเลเวล
            bossCache.v = roomAccess(Farm.target.gate) and X.findBoss(Farm.target) ~= nil
        end
        return bossCache.v
    end

    ---------------- ตีบอส: วิ่งไปตี 1 ที แล้วให้บอทเกมตีอัตโนมัติ (เหมือนฟามเวล) ----------------
    X.doBoss = function(m)
        Farm.inBoss = true
        local name = tostring(m:GetAttribute("DisplayName") or m.Name)
        local root, mp = getRoot(), monsterPos(m)
        if root and mp and horiz(root.Position, mp) > CFG.BossWarpMin then
            stopBot()
            setStatus("บอส " .. name .. " ไกล ลองวาป")
            warpToward(mp, CFG.PillarMinSaving, nil)
        end
        local st = newNav()
        local reach = math.clamp(attackRange() * 0.6, 3, 18)
        local tTravel = os.clock() + CFG.BossTravelTimeout
        local tFight, lastPress, lastTarget, lastStream = nil, 0, 0, 0
        -- เจอบอสเกิดแล้ว (อยู่ในระยะเดินไหว) กดโจมตี 1 ทีทันที ให้บอทเกมตีต่อเอง
        local r0, p0 = getRoot(), monsterPos(m)
        if r0 and p0 and horiz(r0.Position, p0) <= 80 then
            startBot(m)
            tFight, lastPress = os.clock(), os.clock()
        end
        while Farm.on and monsterAlive(m) and (Farm.mode == "boss" or Farm.inBoss) do
            local r2, h2 = getRoot(), getHum()
            mp = monsterPos(m)
            if not r2 or not h2 or h2.Health <= 0 or not mp then break end
            if h2.Sit then h2.Sit = false end
            local now = os.clock()
            local d = horiz(r2.Position, mp)
            if now < Dodge.untilT then
                -- กำลังหลบท่าบอส ปล่อยให้ Drive พาหนี
            elseif d <= reach or (botOn() and d <= 80 and tFight) then
                Drive.point = nil
                tFight = tFight or now
                if not botOn() then
                    if now - lastPress > 3 then
                        lastPress = now
                        startBot(m) -- กด F 1 ที ให้บอทตีเอง
                    end
                elseif now - lastTarget > 2 then
                    lastTarget = now
                    fire("SetTarget", m, false)
                end
                setStatus(string.format("ตีบอส %s Lv%s HP %d", name, tostring(m:GetAttribute("Level")),
                    tonumber(m:GetAttribute("HP")) or 0))
            else
                if botOn() and not tFight then stopBot() end -- กันบอทลากไปตีมอนอื่นระหว่างวิ่งหาบอส
                setStatus("วิ่งไปหาบอส " .. name)
                if now - lastStream > 2.5 then
                    lastStream = now
                    local far = Vector3.new(mp.X, r2.Position.Y, mp.Z)
                    task.spawn(function() pcall(function() LP:RequestStreamAroundAsync(far) end) end)
                end
                if navStep(st, h2, r2, mp) == "fail" then break end
            end
            if not tFight and now > tTravel then break end
            if tFight and now - tFight > CFG.BossTimeout then break end
            task.wait(0.1)
        end
        Drive.point = nil
        if monsterAlive(m) then Farm.bossSkip[m] = os.clock() + 60 end -- ไม่ตาย/ไปไม่ถึง ข้ามไปก่อน
        bossCache.t = 0
        Farm.inBoss = false
        Farm.primed = false
    end

    -- จุดเกิดบอสในห้อง: ใช้ตำแหน่งตราวงกลางของสนาม (Arena.Emblem) ถ้ายังไม่โหลดใช้กลางห้องจากประตู
    local function roomSpot(gid)
        local map = workspace:FindFirstChild("Map")
        local bf = map and map:FindFirstChild("BlockFields")
        local f = bf and bf:FindFirstChild(gid)
        local arena = f and f:FindFirstChild("Arena")
        if arena then
            local emb = arena:FindFirstChild("Emblem", true)
            if emb and emb:IsA("BasePart") then return emb.Position end
            if arena:IsA("Model") then return arena:GetPivot().Position end
        end
        local ar = zoneRange(gid)
        return ar and Vector3.new(ar.x, 0, (ar.top + ar.bottom) / 2) or nil
    end

    -- วิ่ง (วาปก่อนถ้าช่วยได้) ไปยืนที่จุดเกิดบอสในห้อง คืน true ถ้าถึงแล้ว
    local function goToRoom(gid)
        local spot = roomSpot(gid)
        local root = getRoot()
        if not spot or not root then return false end
        if horiz(root.Position, spot) <= 10 then return true end
        setStatus("ไปจุดเกิดบอส " .. gid)
        warpToward(spot, CFG.PillarMinSaving, nil)
        if not Farm.on then return false end
        for _ = 1, 3 do -- รอบแรกอาจใช้ตำแหน่งประมาณ พอเข้าใกล้แมพโหลดแล้วตำแหน่งจริงจะแม่นขึ้น
            spot = roomSpot(gid) or spot
            local ok = walkTo(spot, {stop = 6})
            if not Farm.on then return false end
            local r2 = getRoot()
            if ok and r2 and horiz(r2.Position, roomSpot(gid) or spot) <= 12 then return true end
            if not ok then return false end
        end
        return false
    end

    -- บอสที่เลือกยังไม่เกิด = ไปยืนรอที่จุดเกิดในห้อง (ไม่ไปตีมอนปกติ) พอเกิดจะตีทันที
    X.waitAtRoom = function(e)
        stopBot()
        if not goToRoom(e.gate) then
            setStatus("ไปจุดเกิดบอสไม่ได้ " .. tostring(e.name))
            return
        end
        Drive.point = nil
        local st = X.roomStatus(e)
        setStatus("รอบอส " .. tostring(e.name) .. (st ~= "" and (" · " .. st) or ""))
    end

    -- ฟามบอสทั้งหมด: ตีบอสที่เกิดอยู่ (เลเวลสูงสุดที่ตีไหวก่อน) ถ้าไม่มี ไปรอห้องที่จะเกิดเร็วสุด
    X.bossAllStep = function()
        local lv = tonumber(LP:GetAttribute("Level")) or 1
        local list = {}
        for _, e in ipairs(X.catalog()) do
            if (not e.lv or tonumber(e.lv) <= lv + CFG.BossLvMargin) and roomAccess(e.gate) then
                list[#list + 1] = e
            end
        end
        if #list == 0 then
            -- ยังไม่มีห้องไหนไปได้/ตีไหว ห้ามวิ่งไปหามั่ว ฟามเลเวลตามปกติไปก่อน
            Farm.prefix = "[ยังไม่มีห้องบอสที่ไปได้] "
            farmStep()
            return
        end
        table.sort(list, function(a, b) return (tonumber(a.lv) or 0) > (tonumber(b.lv) or 0) end)
        for _, e in ipairs(list) do
            local m = X.findBoss(e)
            if m then
                Farm.waitGate = nil
                X.doBoss(m)
                return
            end
        end
        local pick
        if Farm.waitGate then
            for _, e in ipairs(list) do if e.gate == Farm.waitGate then pick = e end end
        end
        if not pick then
            local bestLeft
            for _, e in ipairs(list) do
                local left = X.roomLeft(e)
                if left and left > 0 and (not bestLeft or left < bestLeft) then pick, bestLeft = e, left end
            end
            pick = pick or list[1]
            Farm.waitGate = pick.gate
        end
        X.waitAtRoom(pick)
    end

    -- ฟามทั้งหมด: ไปห้องบอสแล้วตีบอสให้ตาย เพื่อเปิดประตูไปด่านถัดไป คืน true ถ้าได้ลงมือ
    X.clearGate = function(gid)
        if not roomAccess(gid) then return false end
        stopBot()
        if not goToRoom(gid) then return false end -- เข้าห้องไม่ได้ ให้ระบบเดินปกติจัดการ
        if not Farm.on then return true end
        local entry = {kind = "gate", gate = gid}
        local m
        local t0 = os.clock()
        while Farm.on and os.clock() - t0 < 20 do
            m = X.findBoss(entry)
            if m then break end
            setStatus("รอบอสห้อง " .. gid .. " เกิด")
            task.wait(0.5)
        end
        if not m then
            Farm.gateDone[gid] = true -- ไม่มีบอสในห้อง ถือว่าผ่านได้แล้ว
            return false
        end
        X.doBoss(m)
        if not monsterAlive(m) then Farm.gateDone[gid] = true end
        return true
    end
end

--==================================================================
-- เปิดกล่องดรอป (ProximityPrompt กด E) ทำงานอัตโนมัติตลอด ไม่ต้องเปิดฟามก็เปิดได้
--   กล่อง: Workspace.LootBoxModel_<id>.LootBox_<id>.OpenPrompt  (+ ปุ่มบนจอ PlayerGui.HuntBoxPrompt)
--   วิธีกด (ลองตามลำดับจนกล่องหาย): InputHoldBegin/End -> fireproximityprompt -> ปุ่ม E จริง -> ปุ่มบนจอ
--   กระเป๋าเต็ม (BAG FULL) ก็ยังลองเปิด ไม่หยุดรอ (เปิดไม่ได้เกิน LootRetry รอบ พักกล่องนั้น 90 วิ)
--==================================================================
do
    local PPS = game:GetService("ProximityPromptService")
    local prompts = {}   -- [prompt] = true  กล่องที่เจอ / ปุ่ม E ที่โผล่ขึ้นมา
    local busy = false

    local function isLootPrompt(p)
        if not p:IsA("ProximityPrompt") then return false end
        local a = p.Parent
        for _ = 1, 4 do
            if not a or a == workspace then return false end
            if a.Name:sub(1, 7) == "LootBox" then return true end
            a = a.Parent
        end
        return false
    end
    local function track(p)
        if p and p.Parent and isLootPrompt(p) then prompts[p] = true end
    end
    pcall(function()
        for _, d in ipairs(workspace:GetDescendants()) do
            if d:IsA("ProximityPrompt") then track(d) end
        end
    end)
    bind(workspace.DescendantAdded, function(d)
        if d:IsA("ProximityPrompt") then task.defer(track, d) end
    end)
    bind(PPS.PromptShown, function(p) track(p) end)  -- ปุ่ม E โผล่บนจอ = อยู่ในระยะกดแล้ว

    local function alive(p)
        return p.Parent ~= nil and p:IsDescendantOf(workspace) and p.Enabled
    end
    local function inRange(p, root)
        local pp = promptPos(p)
        return pp ~= nil and (root.Position - pp).Magnitude <= (p.MaxActivationDistance or 10) - 1
    end
    local function pressGui()
        local g = PG:FindFirstChild("HuntBoxPrompt")
        local btn = g and g:FindFirstChildWhichIsA("GuiButton", true)
        if btn then clickGui(btn) end
    end
    local methods = {
        function(p)   -- ใช้ได้ทั้งมือถือ/PC ไม่ต้องพึ่งฟังก์ชันของ executor
            p:InputHoldBegin()
            task.wait(math.max(p.HoldDuration or 0, 0) + 0.12)
            p:InputHoldEnd()
        end,
        function(p) if typeof(fireproximityprompt) == "function" then fireproximityprompt(p) end end,
        function(p) triggerPrompt(p, true) end,   -- ปุ่ม E จริง
        function() pressGui() end,
    }
    local function waitGone(p, t)
        local t0 = os.clock()
        while os.clock() - t0 < t do
            if not alive(p) then return true end
            task.wait(0.1)
        end
        return not alive(p)
    end

    -- ลองเปิดกล่องหนึ่งใบ (ต้องอยู่ในระยะ) กล่องหายไป = เปิดสำเร็จ
    local function attempt(p)
        local t0 = os.clock()
        while busy and os.clock() - t0 < 6 do task.wait(0.1) end
        if busy then return end
        busy = true
        pcall(function()
            local opened = false
            for _, m in ipairs(methods) do
                if not alive(p) then opened = true break end
                pcall(m, p)
                if waitGone(p, 1.0) then opened = true break end
            end
            if opened or not alive(p) then
                Loot.tries[p] = nil
            else
                Loot.tries[p] = (Loot.tries[p] or 0) + 1
                if Loot.tries[p] >= CFG.LootRetry then
                    Loot.skip[p] = os.clock() + 90
                    Loot.tries[p] = nil
                end
            end
        end)
        busy = false
    end

    -- เธรดพื้นหลัง: กล่องไหนอยู่ในระยะกด E ก็เปิดเลย (ไม่ขึ้นกับ Auto Farm)
    task.spawn(function()
        while gui.Parent do
            task.wait(0.35)
            local root, hum = getRoot(), getHum()
            if root and hum and hum.Health > 0 and not busy then
                local now = os.clock()
                for p in pairs(prompts) do
                    if not p.Parent or not p:IsDescendantOf(workspace) then
                        prompts[p], Loot.tries[p], Loot.skip[p] = nil, nil, nil
                    elseif p.Enabled and not (Loot.skip[p] and Loot.skip[p] > now) and inRange(p, root) then
                        attempt(p)
                        break
                    end
                end
            end
        end
    end)

    -- เรียกจากลูปฟาม: เห็นกล่องใกล้ ๆ (มอน/บอสตาย) เดินไปหาแล้วเปิด
    function Loot.collect()
        if not Farm.on then return end
        for _ = 1, 6 do
            local root, hum = getRoot(), getHum()
            if not root or not hum or hum.Health <= 0 or not Farm.on then return end
            local best, bd, now = nil, nil, os.clock()
            for p in pairs(prompts) do
                if p.Parent and alive(p) and not (Loot.skip[p] and Loot.skip[p] > now) then
                    local pp = promptPos(p)
                    if pp then
                        local d = horiz(root.Position, pp)
                        if d <= CFG.LootSeek and (not bd or d < bd) then best, bd = p, d end
                    end
                end
            end
            if not best then return end
            if not inRange(best, root) then
                local pp = promptPos(best)
                setStatus("เดินไปเปิดกล่อง")
                walkTo(Vector3.new(pp.X, root.Position.Y, pp.Z),
                    {stop = math.max((best.MaxActivationDistance or 10) - 3, 3), timeout = 15})
                if not Farm.on then return end
            end
            root = getRoot()
            if root and alive(best) and inRange(best, root) then
                setStatus("กด E เปิดกล่อง")
                attempt(best)
            elseif alive(best) then
                Loot.tries[best] = (Loot.tries[best] or 0) + 1   -- เดินไปไม่ถึง
                if Loot.tries[best] >= CFG.LootRetry then
                    Loot.skip[best] = os.clock() + 90
                    Loot.tries[best] = nil
                end
            end
            task.wait(0.1)
        end
    end
end

--==================================================================
-- วิ่งเร็วตลอด + สตามีน่าไม่จำกัด
--==================================================================
local Boost = {sprint = true, stamina = true, patched = {}, held = false}

local function staminaConfig()
    local shared = RepS:FindFirstChild("Shared")
    local mod = shared and shared:FindFirstChild("StaminaConfig")
    if not mod then return nil end
    local ok, cfg = pcall(require, mod)
    if ok and type(cfg) == "table" then return cfg end
    return nil
end

local function patchStamina(on)
    local cfg = staminaConfig()
    if not cfg then return 0 end
    if on then
        if #Boost.patched > 0 then return #Boost.patched end   -- แพตช์ไปแล้ว ห้ามทับซ้ำ (ไม่งั้นตอนคืนค่าจะได้ 0)
        local function walk(t, depth)
            for k, v in pairs(t) do
                local key = tostring(k):lower()
                if type(v) == "number" and (key:find("drain") or key:find("cost") or key:find("consume")) then
                    if pcall(function() t[k] = 0 end) then
                        Boost.patched[#Boost.patched + 1] = {t, k, v}
                    end
                elseif type(v) == "table" and depth < 3 then
                    walk(v, depth + 1)
                end
            end
        end
        walk(cfg, 0)
    else
        for _, e in ipairs(Boost.patched) do
            pcall(function() e[1][e[2]] = e[3] end)
        end
        Boost.patched = {}
    end
    return #Boost.patched
end

bind(RS.Heartbeat, function()
    if not Boost.stamina then return end
    local mx = tonumber(LP:GetAttribute("LumiStaminaMax")) or 100
    local cur = tonumber(LP:GetAttribute("LumiStamina"))
    if cur and cur < mx then LP:SetAttribute("LumiStamina", mx) end
    if LP:GetAttribute("LumiStaminaEmpty") == true then LP:SetAttribute("LumiStaminaEmpty", false) end
end)

local function sprintKey(down)
    if not VIM then return end
    pcall(function() VIM:SendKeyEvent(down, CFG.SprintKey, false, game) end)
end

task.spawn(function()
    local lastTry = 0
    while gui.Parent do
        local hum = getHum()
        if Boost.sprint and hum then
            local base = tonumber(LP:GetAttribute("LumiBaseSpeed")) or 16
            local fast = hum.WalkSpeed > base * 1.05
            if LP:GetAttribute("LumiSprinting") ~= true then
                pcall(function() LP:SetAttribute("LumiSprinting", true) end)
            end
            if not fast and os.clock() - lastTry > 2 then
                lastTry = os.clock()
                sprintKey(false)
                task.wait(0.05)
                sprintKey(true)
                Boost.held = true
            end
        elseif Boost.held and not Boost.sprint then
            Boost.held = false
            sprintKey(false)
            if LP:GetAttribute("LumiSprinting") == true then
                pcall(function() LP:SetAttribute("LumiSprinting", false) end)
            end
        end
        task.wait(0.3)
    end
end)

--==================================================================
-- เซฟค่าอัตโนมัติ (ใช้ writefile/readfile ของ executor ถ้าไม่มีจะใช้ค่าเริ่มต้นทุกครั้ง)
--==================================================================
local SAVE_FILE = "JustHubLite_settings.json"
local Settings = {
    -- ค่าเริ่มต้น: ฟังก์ชันที่จำเป็นเปิดไว้ให้เลย (Auto Farm เริ่มปิดไว้ แล้วจำค่าที่กดล่าสุดต่อไป)
    data = {mode = "all", farm = false, dodge = true, afk = true, sprint = true, stamina = true},
    pending = false,
}
function Settings.load()
    pcall(function()
        if typeof(isfile) == "function" and typeof(readfile) == "function" and isfile(SAVE_FILE) then
            local d = HttpS:JSONDecode(readfile(SAVE_FILE))
            if type(d) == "table" then
                for k, def in pairs(Settings.data) do
                    if type(d[k]) == type(def) then Settings.data[k] = d[k] end
                end
            end
        end
    end)
end
function Settings.set(k, v)
    Settings.data[k] = v
    if Settings.pending then return end
    Settings.pending = true
    task.delay(0.4, function()   -- รวมการเปลี่ยนหลายอย่างใกล้กันให้เขียนไฟล์ครั้งเดียว
        Settings.pending = false
        pcall(function()
            if typeof(writefile) == "function" then writefile(SAVE_FILE, HttpS:JSONEncode(Settings.data)) end
        end)
    end)
end
Settings.load()
local S = Settings.data
Boost.sprint, Boost.stamina = S.sprint, S.stamina
X.T.dodge = S.dodge
