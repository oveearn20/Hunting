    local function decode(key)
        local raw = LP:GetAttribute(key)
        if type(raw) ~= "string" or raw == "" then return nil end
        local ok, res = pcall(function() return HttpS:JSONDecode(raw) end)
        return ok and res or nil
    end
    local job = LP:GetAttribute("Job")
    local bot = decode("BotJson")
    if bot and type(bot.Skills) == "table" and job and type(bot.Skills[job]) == "table" and bot.Skills[job][1] then
        return bot.Skills[job][1]
    end
    local bar = decode("HotbarJson")
    if type(bar) == "table" then
        for i = 1, 12 do
            local v = bar[tostring(i)]
            if type(v) == "string" then
                local id = v:match("^skill:(.+)$")
                if id then return id end
            end
        end
    end
    local sk = decode("SkillsJson")
    if type(sk) == "table" then
        for id in pairs(sk) do return id end
    end
    return nil
end

