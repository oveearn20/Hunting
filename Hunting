--========== helpers ==========
local conns = {}
local function bind(signal, fn)
    local c = signal:Connect(fn)
    conns[#conns + 1] = c
    return c
end

local function new(class, props, parent)
    local o = Instance.new(class)
    for k, v in pairs(props) do o[k] = v end
    o.Parent = parent
    return o
end
local function round(o, r) return new("UICorner", {CornerRadius = UDim.new(0, r or 10)}, o) end
local function stroke(o, col, th, tr) return new("UIStroke", {Color = col or C.bright, Thickness = th or 1.2, Transparency = tr or 0.4}, o) end
local function grad(o, c1, c2, rot) return new("UIGradient", {Color = ColorSequence.new(c1, c2), Rotation = rot or 90}, o) end
local function tw(o, t, p, style, dir)
    local tween = TS:Create(o, TweenInfo.new(t, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), p)
    tween:Play()
    return tween
end
local function text(parent, str, size, font, props)
    local t = new("TextLabel", {Text = str, TextSize = size, Font = font or Enum.Font.GothamBold,
        TextColor3 = C.white, BackgroundTransparency = 1}, parent)
    for k, v in pairs(props or {}) do t[k] = v end
    return t
end

local function drag(handle, target, onTap)
    local dragging, start, origin, moved
    bind(handle.InputBegan, function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            dragging, moved, start, origin = true, false, i.Position, target.Position
        end
    end)
    bind(UIS.InputChanged, function(i)
        if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
            local d = i.Position - start
            if d.Magnitude > 6 then moved = true end
            target.Position = UDim2.new(origin.X.Scale, origin.X.Offset + d.X, origin.Y.Scale, origin.Y.Offset + d.Y)
        end
    end)
    bind(UIS.InputEnded, function(i)
        if dragging and (i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch) then
            dragging = false
            if not moved and onTap then onTap() end
        end
    end)
end

