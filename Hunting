local function gateTable()
    local list = {}
    for name, z in pairs(GATE_FALLBACK) do list[name] = {z = z, x = 0} end
    local map = workspace:FindFirstChild("Map")
    local gates = map and map:FindFirstChild("Gates")
    if gates then
        for _, g in ipairs(gates:GetChildren()) do
            local gz = g:GetAttribute("GateZ")
            if type(gz) == "number" then
                local nm = (g.Name:gsub("^Gate_", ""))
                local gx = 0
                local ok, cf = pcall(function() return g:GetPivot() end)
                if ok and cf then gx = cf.Position.X end
                list[nm] = {z = gz, x = gx}
            end
        end
    end
    return list
end

local function zoneRange(id)
    if not id then return nil end
    local gl = gateTable()
    local g = gl[id]
    if not g then return nil end
    local nextZ = nil
    for _, v in pairs(gl) do
        if v.z < g.z and (nextZ == nil or v.z > nextZ) then nextZ = v.z end
    end
    return {x = g.x, top = g.z, bottom = nextZ or (g.z - 250)}
end

local function inZone(pos, id, margin)
    local r = zoneRange(id)
    if not r then return false end
    margin = margin or 0
    return pos.Z <= r.top + margin and pos.Z >= r.bottom - margin
end

-- "ถึงโซนมอนจริง" = เลยปากโซน/บันไดเข้าไปลึกพอ (มอนจะโหลดก็ต่อเมื่อเข้ามาถึงตรงนี้)
local function deepIn(pos, id)
    local r = zoneRange(id)
    if not r then return false end
    local need = math.min(CFG.EnterDepth, (r.top - r.bottom) * 0.25)
    return pos.Z <= r.top - need and pos.Z >= r.bottom - 10
end

local function refreshZones()
    local map = workspace:FindFirstChild("Map")
    local bar = map and map:FindFirstChild("Barriers")
    if not bar then return end
    local function lockLevel(id)
        local lock = bar:FindFirstChild("BossLock_" .. id)
        local txt = lock and lock:GetAttribute("LockText")
        if type(txt) ~= "string" then return nil end
        local lv = txt:match("Lv%.?%s*(%d+)")
        return lv and tonumber(lv) or nil
    end
    for i, z in ipairs(CFG.ZONES) do
        local lv = lockLevel(z.id)
        local nxt = CFG.ZONES[i + 1]
        if lv and nxt then nxt.minLevel = lv end
    end
    local gl = gateTable()
    for _ = 1, 30 do
        local last = CFG.ZONES[#CFG.ZONES]
        local n = tonumber(last.id:match("%d+"))
        local lv = lockLevel(last.id)
        local nextId = string.format("Field%02d", (n or 0) + 1)
        if lv and gl[nextId] then
            CFG.ZONES[#CFG.ZONES + 1] = {id = nextId, minLevel = lv}
        else
            break
        end
    end
end

